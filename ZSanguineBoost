local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

-- Configuración del boost (AQUÍ ES DONDE SE AUMENTA LA DISTANCIA)
local velocityPower = 400   -- Antes era 150. Cuanto más alto, más rápido irá.
local boostDuration = 0.9   -- Antes era 0.5. Cuanto más alto, más tiempo se mantendrá la velocidad.

local lagGui = nil

local function destroyLagGui()
    if lagGui and lagGui.Parent then
        lagGui:Destroy()
        lagGui = nil
    end
end

local function doBoost()
    local character = player.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dir = camera.CFrame.LookVector

    local att = Instance.new("Attachment")
    att.Parent = hrp

    local lv = Instance.new("LinearVelocity")
    lv.MaxForce = math.huge -- Se cambió a math.huge para asegurar fuerza infinita
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.VectorVelocity = dir * velocityPower
    lv.Attachment0 = att
    lv.Parent = hrp

    task.delay(boostDuration, function()
        if lv and lv.Parent then lv:Destroy() end
        if att and att.Parent then att:Destroy() end
    end)
end

local function activateButtonVisual(zBtn)
    if zBtn:GetAttribute("Cooldown") then return end
    zBtn:SetAttribute("Cooldown", true)
    
    doBoost()
    zBtn.Text = "!"
    zBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
    
    task.wait(0.35)
    
    zBtn.Text = "Z"
    zBtn.BackgroundColor3 = Color3.fromRGB(210, 140, 255)
    zBtn:SetAttribute("Cooldown", false)
end

local function createLagGui()
    destroyLagGui()
    local gui = Instance.new("ScreenGui", playerGui)
    gui.Name = "SanguineBoost"
    gui.ResetOnSpawn = false
    lagGui = gui

    local f = Instance.new("Frame", gui)
    f.Size = UDim2.new(0, 90, 0, 42)
    f.Position = UDim2.new(0.37, 0, 0.26, 0)
    f.BackgroundColor3 = Color3.fromRGB(75, 30, 135)
    f.Active = true
    f.Draggable = true 
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 12)

    local zBtn = Instance.new("TextButton", f)
    zBtn.Size = UDim2.new(0, 40, 0, 30)
    zBtn.Position = UDim2.new(0, 12, 0, 6)
    zBtn.BackgroundColor3 = Color3.fromRGB(210, 140, 255)
    zBtn.Text = "Z"
    zBtn.TextSize = 18
    zBtn.TextColor3 = Color3.new(1, 1, 1)
    zBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", zBtn).CornerRadius = UDim.new(0, 8)

    zBtn.MouseButton1Click:Connect(function()
        activateButtonVisual(zBtn)
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Z then
            activateButtonVisual(zBtn)
        end
    end)
end

createLagGui()
