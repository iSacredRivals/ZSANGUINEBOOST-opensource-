local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

-- Configuración del boost
local velocityPower = 400   
local boostDuration = 0.9   

-- Configuración del Fake Lag
local DROP_TO_FPS = 20
local LAG_DURATION = 0.43
local SANGUINE_ANIMATION_ID = "rbxassetid://15682737850" -- Confirma si el ID cambia en updates

local lagGui = nil
local lagBusy = false

-- Limpiar GUI anterior si existe
local function destroyLagGui()
    if lagGui and lagGui.Parent then
        lagGui:Destroy()
        lagGui = nil
    end
end

-- Función de Fake Lag (FPS Drop)
local function dropFPS()
    if lagBusy then return end
    lagBusy = true
    
    local stop = tick() + LAG_DURATION
    local interval = 1 / DROP_TO_FPS
    local con
    
    con = RunService.RenderStepped:Connect(function()
        if tick() > stop then
            if con then con:Disconnect() end
            return
        end
        local now = tick()
        -- Bucle para congelar los frames intencionalmente
        while tick() - now < interval do end
    end)
    
    task.wait(0.10)
    lagBusy = false
end

-- Función de Boost (Velocidad)
local function doBoost()
    local character = player.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dir = camera.CFrame.LookVector

    local att = Instance.new("Attachment")
    att.Parent = hrp

    local lv = Instance.new("LinearVelocity")
    lv.MaxForce = math.huge 
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.VectorVelocity = dir * velocityPower
    lv.Attachment0 = att
    lv.Parent = hrp

    task.delay(boostDuration, function()
        if lv and lv.Parent then lv:Destroy() end
        if att and att.Parent then att:Destroy() end
    end)
end

-- Lógica principal al presionar el botón o la tecla
local function activateButtonVisual(zBtn)
    if zBtn:GetAttribute("Cooldown") then return end
    zBtn:SetAttribute("Cooldown", true)
    
    -- Ejecutar ambos: Boost y Fake Lag
    doBoost()
    dropFPS()
    
    -- Efectos visuales del botón
    zBtn.Text = "!"
    zBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
    
    task.wait(0.35)
    
    zBtn.Text = "Z"
    zBtn.BackgroundColor3 = Color3.fromRGB(210, 140, 255)
    zBtn:SetAttribute("Cooldown", false)
end

-- Detector de animación para el Fake Lag automático
local function connectSanguineWatcher()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    
    -- Limpiar flag viejo si el personaje respawnea
    if hum:FindFirstChild("__CUPIDS_SANGUINE") then
        hum:FindFirstChild("__CUPIDS_SANGUINE"):Destroy()
    end
    
    local flag = Instance.new("BoolValue")
    flag.Name = "__CUPIDS_SANGUINE"
    flag.Parent = hum
    
    hum.AnimationPlayed:Connect(function(anim)
        if tostring(anim.Animation.AnimationId):find(SANGUINE_ANIMATION_ID) then
            dropFPS()
        end
    end)
end

-- Creación de la interfaz
local function createLagGui()
    destroyLagGui()
    local gui = Instance.new("ScreenGui", playerGui)
    gui.Name = "SanguineBoost"
    gui.ResetOnSpawn = false
    lagGui = gui

    local f = Instance.new("Frame", gui)
    f.Size = UDim2.new(0, 90, 0, 42)
    f.Position = UDim2.new(0.37, 0, 0.26, 0)
    f.BackgroundColor3 = Color3.fromRGB(75, 30, 135)
    f.Active = true
    f.Draggable = true 
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 12)

    local zBtn = Instance.new("TextButton", f)
    zBtn.Size = UDim2.new(0, 40, 0, 30)
    zBtn.Position = UDim2.new(0, 12, 0, 6)
    zBtn.BackgroundColor3 = Color3.fromRGB(210, 140, 255)
    zBtn.Text = "Z"
    zBtn.TextSize = 18
    zBtn.TextColor3 = Color3.new(1, 1, 1)
    zBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", zBtn).CornerRadius = UDim.new(0, 8)

    -- Evento de Clic en la GUI
    zBtn.MouseButton1Click:Connect(function()
        activateButtonVisual(zBtn)
    end)

    -- Evento de Tecla Z
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Z then
            activateButtonVisual(zBtn)
        end
    end)
end

-- Inicializar sistemas
player.CharacterAdded:Connect(function()
    task.wait(1)
    connectSanguineWatcher()
end)

if player.Character then connectSanguineWatcher() end
createLagGui()
